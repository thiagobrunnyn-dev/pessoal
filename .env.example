# ============================================================
# Mobiliza — variáveis de ambiente (copie para .env e preencha)
# Nunca commite o .env. Segredos ficam só na VPS.
# ============================================================

# --- Aplicação ---
NODE_ENV=production
PORT=3000
# Domínio público (usado pelo Caddy para HTTPS automático)
APP_DOMAIN=mobiliza.seudominio.com.br
# E-mail para avisos de certificado TLS (Let's Encrypt)
ACME_EMAIL=admin@seudominio.com.br

# --- Proprietário (Supabase Auth → Authentication → Users → UID do Thiago) ---
# Sem isso ninguém é reconhecido como administrador.
SITE_OWNER_ID=

# --- Supabase ---
# Project Settings → API
SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
# chave anon/publishable (vai para o navegador)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# chave service_role (SOMENTE servidor; dá acesso total ao Storage)
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: segredo JWT legado (HS256). Se vazio, o servidor valida via JWKS do projeto (chaves assimétricas).
SUPABASE_JWT_SECRET=

# --- Banco (SQLite, compatível com o D1 original) ---
DATA_DIR=/data
DATABASE_PATH=/data/mobiliza.sqlite
# aplica migrações pendentes ao iniciar (true/false)
AUTO_MIGRATE=true

# --- Arquivos/fotos ---
# supabase = Supabase Storage (bucket PRIVADO) | local = disco em $DATA_DIR/storage
STORAGE_BACKEND=supabase
SUPABASE_STORAGE_BUCKET=mobiliza

# --- n8n (mesmo compose) ---
N8N_HOST=n8n.seudominio.com.br
N8N_ENCRYPTION_KEY=gere-uma-chave-longa-e-aleatoria
# Postgres do Supabase para o n8n (Project Settings → Database → Connection string, modo session/porta 5432)
N8N_DB_HOST=db.SEU_PROJETO.supabase.co
N8N_DB_PORT=5432
N8N_DB_NAME=postgres
N8N_DB_USER=postgres
N8N_DB_PASSWORD=
N8N_DB_SCHEMA=n8n
GENERIC_TIMEZONE=America/Sao_Paulo

# --- Backup do SQLite para o Supabase Storage (cron no container de backup) ---
BACKUP_BUCKET=mobiliza-backups
# cron (padrão: 03:15 todo dia)
BACKUP_CRON=15 3 * * *
BACKUP_KEEP_DAYS=30
