}

# Mobiliza (Next.js)
{$APP_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	request_body {
		max_size 64MB
	}
	reverse_proxy app:3000 {
		header_up X-Forwarded-Proto https
		# Identidade é decidida só pelo servidor do app: nunca repassa headers forjados.
		header_up -oai-authenticated-user-id
		header_up -oai-authenticated-user-email
		header_up -oai-authenticated-user-full-name
		header_up -oai-authenticated-user-full-name-encoding
	}
}

# n8n
{$N8N_HOST} {
	encode zstd gzip
	header -Server
	reverse_proxy n8n:5678 {
		flush_interval -1
	}
}
